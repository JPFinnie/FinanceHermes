# FinanceHermes — required environment variables.
# Set these in the Vercel project (Settings → Environment Variables) — they are
# only ever read server-side in api/agent.js and are never sent to the browser.
# For local `vercel dev`, copy this file to .env and fill in real values.
# (.env is gitignored — never commit real keys.)

# ── Model provider — set ONE of the following ────────────────────────────────
# Option A: Nous Portal inference API (https://portal.nousresearch.com)
#           OpenAI-compatible endpoint at https://inference-api.nousresearch.com/v1
NOUS_API_KEY=

# Option B: OpenRouter (https://openrouter.ai) — Hermes models under nousresearch/*
OPENROUTER_API_KEY=

# ── Model selection (optional) ───────────────────────────────────────────────
# Default: nousresearch/hermes-4-405b on both Nous Portal and OpenRouter — the
# Portal resolves models through the same namespaced catalog OpenRouter uses,
# so the nousresearch/ prefix is required on both.
# Smaller/faster options include nousresearch/hermes-4-70b and
# nousresearch/hermes-4.3-36b.
# $0 option: OpenRouter's free Hermes endpoint (rate-limited, supports tools):
#   HERMES_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
HERMES_MODEL=

# Opt-in: Hermes-4 deep-thinking mode (<think> traces shown in the UI).
# Impressive but slower — leave off for a snappy live meeting demo.
HERMES_REASONING=

# ── Web search (required for live research) ──────────────────────────────────
# Tavily (https://app.tavily.com/home) — the search backend Neo/hermes-agent
# supports out of the box. Free tier: 1,000 credits/month, no card — plenty
# (a typical run uses 2-4). Without this the agent still answers, model-only,
# with a clear on-page warning.
TAVILY_API_KEY=

# ── Advanced overrides (optional; mainly for testing/self-hosting) ───────────
# Any OpenAI-compatible endpoint. Takes precedence over the options above.
HERMES_BASE_URL=
HERMES_API_KEY=
# Override Tavily endpoint (used by the offline mock harness in dev/).
TAVILY_BASE_URL=
# Public site URL, sent to OpenRouter as HTTP-Referer attribution.
SITE_URL=
